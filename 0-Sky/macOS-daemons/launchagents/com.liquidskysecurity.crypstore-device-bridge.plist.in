<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.liquidskysecurity.crypstore-device-bridge.__INSTANCE__</string>
	<key>ProgramArguments</key>
	<array>
		<string>__SUPPORT__/instances/__INSTANCE__/automation/CrypStoreAutomation/device_bridge_supervisor</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>CRYPSTORE_DEVICE_HOST</key>
		<string>127.0.0.1</string>
		<key>CRYPSTORE_DEVICE_PORT</key>
		<string>__PORT__</string>
		<key>CRYPSTORE_DEVICE_USER</key>
		<string>root</string>
		<key>CRYPSTORE_DEVICE_KEY</key>
		<string>__SSH_KEY__</string>
		<key>CRYPSTORE_DEVICE_UDID</key>
		<string>__UDID__</string>
		<key>CRYPSTORE_HOST_KEY_FINGERPRINT</key>
		<string>__KEY_FINGERPRINT__</string>
		<key>CRYPSTORE_INSTANCE_DIR</key>
		<string>__SUPPORT__/instances/__INSTANCE__</string>
		<key>SRD_PYTHON</key>
		<string>__PYTHON__</string>
		<key>CRYPSTORE_LDID</key>
		<string>__LDID__</string>
		<key>SRD_CRYPTEXCTL</key>
		<string>/System/Library/SecurityResearch/usr/bin/cryptexctl</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>StandardOutPath</key>
	<string>__SUPPORT__/instances/__INSTANCE__/logs/com.liquidskysecurity.crypstore-device-bridge.__INSTANCE__.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>__SUPPORT__/instances/__INSTANCE__/logs/com.liquidskysecurity.crypstore-device-bridge.__INSTANCE__.stderr.log</string>
</dict>
</plist>
